@performance{Kokke22SepEB,
  author     = {Wen Kokke and Lilith W. Lee},
  title      = {{How to Talk about Youtube Radicalisation: Framing Social-Epistemological Approaches to Recommender-Driven Radicalisation}},
  shorttitle = {{How to Talk about Youtube Radicalisation}},
  venue      = {Amsterdam, NL},
  month      = sep,
  year       = {2022},
  eventtitle = {{Extreme Beliefs 2022}},
  abstract   = {Questions regarding radicalisation aided by machine-learning algorithms
                often do not have a straightforward answer. Social media platforms that
                involve such algorithms for content- promotion are important nexuses of
                active and passive user-engagement—but the interactions of the two types
                of engagement in radicalisation are opaque in both practice and theory
                (cf. Cassam 2022). Our aim in this paper is to offer some direction for
                the latter: by clarifying the question-set relevant for understanding
                what we call recommender-driven radicalisation. Specifically, we consider
                the following question as an example here: ‘Did the YouTube recommendation
                system contribute to alt-right radicalisation? And if so, how?’
                The question, we advance, involves two black-box systems, i.e., systems the
                operations of which are not directly visible to us. The first concerns the
                algorithmic operations of YouTube’s recommender system. The second concerns
                the epistemic operations of the users.

                We propose a theoretical framework for approaching such complex problems
                that involve both black-box systems. We build on a levels-of-analysis
                framework, originally by David Marr (1982), and recently expanded by Carlos
                Zednik (2019) to allow explanations about machine learning systems. Zednik
                uses the black-box problem to refer to problems involving machine learning
                systems. We further expand this framework to account for the second type of
                black box problem, explaining user radicalisation. We demonstrate the
                importance of our framework by examining the methodological, explanatory,
                and critical inadequacies of a recent social- epistemological attempt by Mark
                Alfano et al. (2020) to approach the question of YouTube radicalisation.
                We use their attempt as a foil and consider how their shortcomings are
                indicative of the need for our more expansive framework in answering
                questions on black-box radicalisation.}
}

