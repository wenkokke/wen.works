---
import "../assets/css/blog-post.css";
import { Time } from "@astro-github-elements/time";
import Layout from "./Layout.astro";
const { frontmatter } = Astro.props;
---

<Layout frontmatter={frontmatter}>
  <h1>{frontmatter.title}</h1>
  <p class="subtitle blog-post-meta">
    Written by
    <span class="blog-post-author">
      {frontmatter.author}
    </span>
    on
    <Time class="blog-post-pubDate" format="datetime" datetime={frontmatter.pubDate} />
  </p>
  <slot />
</Layout>
