---
import { Time } from "@astro-github-elements/time";
import { slug, teaser } from "../site";
const { frontmatter } = Astro.props;
---

<dt class="blog-post-item">
  <span class="blog-post-summary">
    <a href={slug(frontmatter)}>{frontmatter.data.title}</a>
    { frontmatter.data.pubDate === "draft"
      ? <span class="blog-post-pubDate">Draft</span>
      : <Time class="blog-post-pubDate" format="datetime" datetime={frontmatter.data.pubDate} />
    }
  </span>
</dt>
<dd>
  <Fragment set:html={teaser(frontmatter)} />
  <p>
    <a href={slug(frontmatter)}>Continue reading...</a>
  </p>
</dd>
